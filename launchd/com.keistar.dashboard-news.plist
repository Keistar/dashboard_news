<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 毎日 15:30（この Mac の時刻）に scripts/run_daily.sh を動かす。scripts/install_launchd.sh が __RUNNER_DIR__ を埋めて
     ~/Library/LaunchAgents に置く。スリープ中に時刻を過ぎたら、起きたときに 1 回動く（電源が切れていたら動かない）。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.keistar.dashboard-news</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__RUNNER_DIR__/scripts/run_daily.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__RUNNER_DIR__</string>
  <!-- 2026-10-09〜: agy の Gemini 3.1 Pro（Google AI Pro の枠）で書かせる（NEWS_ENGINE=agy。戻すなら消す）。
       agy の Claude のモデルは枠が小さく（数回で 5 時間の枠がほぼ尽きた）、1 日 10 回は回らない。Gemini の質はニュースの選別と要約なら足りた。claude で動かすときのモデルは Sonnet
       （ただし claude の Sonnet は許可したコマンドの形を外して 3 ジャンル失敗した。claude に戻すなら NEWS_MODEL も消して Opus に）。既定の Opus だと Claude のサブスクの枠を多く使い、日中の作業が上限に当たりやすかった。
       Sonnet で書かせた下書き・ニュースの質を見て決めた。戻すなら値を消す（既定のモデルになる）。 -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>NEWS_ENGINE</key>
    <string>agy</string>
    <key>NEWS_AGY_MODEL</key>
    <string>gemini-3.1-pro-high</string>
    <key>NEWS_MODEL</key>
    <string>sonnet</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>15</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__RUNNER_DIR__/logs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__RUNNER_DIR__/logs/launchd.log</string>
</dict>
</plist>
